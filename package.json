{
  "name": "game-automation-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.19.0" },
  "scripts": {
    "generate": "node tools/generate-contracts.mjs && node tools/generate-codex-types.mjs",
