{
  "name": "game-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.19.0"
  },
  "scripts": {
    "trace": "node tools/serve-trace.mjs",
    "generate": "node tools/generate-contracts.mjs && node tools/generate-codex-types.mjs",
    "check": "npm run generate && tsc --noEmit && eslint apps packages plugins/agent_codex --max-warnings 0",
    "build": "npm run check && node tools/build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/agent_codex"
  ]
}
