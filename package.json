  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0"
  }
}
