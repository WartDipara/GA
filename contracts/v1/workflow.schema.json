{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/workflow",
  "type": "object",
  "required": [
    "kind", "source_ids", "instances", "credential_profile", "goal",
    "max_turns", "stages", "adopt_existing"
  ],
  "properties": {
    "kind": {"const": "apk_workflow"},
    "source_ids": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "instances": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "credential_profile": {"type": "string", "minLength": 1},
    "goal": {"enum": ["login-and-interact", "explore", "advance-battle"]},
    "max_turns": {"type": "integer", "minimum": 0},
    "stages": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "adopt_existing": {"type": "boolean"}
  },
  "additionalProperties": false
}
