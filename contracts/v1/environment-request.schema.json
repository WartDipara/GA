{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/environment-request",
  "type": "object",
  "properties": {
    "platform": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "adb_executable": { "type": "string", "minLength": 1 },
    "device_serial": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "command_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 }
  },
  "required": ["platform", "target", "adb_executable", "device_serial", "command_timeout_seconds"],
  "additionalProperties": false
}
