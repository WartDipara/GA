{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/gameplay-agent-settings",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "agent": {
      "type": "object",
      "properties": {
        "job_title": {
          "enum": [
            "Test Lead",
            "Evidence Judge",
            "Interface Specialist",
            "Exploration Specialist",
            "Comparison Specialist"
          ]
        },
        "describ": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "job_title",
        "describ",
        "model",
        "reasoning_effort"
      ],
      "additionalProperties": false
    }
  },
  "minProperties": 5,
  "maxProperties": 5,
  "patternProperties": {
    "^agent_[a-z][a-z0-9_]{0,47}$": {
      "$ref": "#/$defs/agent"
    }
  }
}
