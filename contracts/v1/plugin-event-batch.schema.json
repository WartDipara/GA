{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/plugin-event-batch",
  "type": "array",
  "minItems": 1,
  "maxItems": 16,
  "items": {
    "type": "object",
    "properties": {
      "event_id": { "type": "string", "minLength": 1 },
      "kind": {
        "type": "string",
        "pattern": "^(provider|ai|plugin)\\.",
        "not": { "const": "ai.session" }
      },
      "payload": { "type": "object" }
    },
    "required": ["event_id", "kind", "payload"],
    "additionalProperties": false
  }
}
