{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/device-execute-request",
  "type": "object",
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "manager_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adb_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "instance_index": {
          "type": "integer",
          "minimum": 0
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "command_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "manager_executable",
        "adb_executable",
        "instance_index",
        "instance_id",
        "serial",
        "command_timeout_seconds"
      ],
      "additionalProperties": false
    },
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "boot_id": {
          "type": "string",
          "maxLength": 2000
        },
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "main_process": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 0
                },
                "uid": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string",
                  "maxLength": 2000
                },
                "state": {
                  "type": "string",
                  "maxLength": 2000
                },
                "start_ticks": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "pid",
                "uid",
                "name",
                "state",
                "start_ticks"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 0
              },
              "uid": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "maxLength": 2000
              },
              "state": {
                "type": "string",
                "maxLength": 2000
              },
              "start_ticks": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "pid",
              "uid",
              "name",
              "state",
              "start_ticks"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "integer",
                "minimum": 0
              },
              "display_id": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "task_id",
              "display_id"
            ],
            "additionalProperties": false
          }
        },
        "alive": {
          "type": "boolean"
        },
        "focused_display": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "display_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "rotation_degrees": {
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                "package_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
                },
                "activity": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "display_id",
                "rotation_degrees",
                "width",
                "height",
                "package_name",
                "activity"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "foreground_window": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "window_id": {
                  "type": "string",
                  "maxLength": 240
                },
                "task_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "display_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "package_name": {
                  "type": "string",
                  "maxLength": 240
                }
              },
              "required": [
                "window_id",
                "task_id",
                "display_id",
                "package_name"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "window_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          },
          "maxItems": 1000
        }
      },
      "required": [
        "boot_id",
        "package_name",
        "main_process",
        "processes",
        "tasks",
        "alive",
        "focused_display"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "tap",
            "swipe",
            "long_press",
            "back",
            "wait",
            "credential",
            "launch",
            "return"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "end_x": {
          "type": "integer",
          "minimum": 0
        },
        "end_y": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "bounds": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_field": {
          "enum": [
            "username",
            "password",
            null
          ]
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "end_x",
        "end_y",
        "duration_ms",
        "bounds",
        "credential_field"
      ],
      "additionalProperties": false
    },
    "sensitive_regions": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 4,
        "maxItems": 4
      },
      "maxItems": 30
    },
    "observation_path": {
      "type": "string",
      "maxLength": 2000
    },
    "credential_path": {
      "type": "string",
      "maxLength": 2000
    },
    "target_guard": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "page_guard": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "noise_regions": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              },
              "maxItems": 256
            }
          },
          "required": [
            "sha256",
            "noise_regions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session",
    "package_name",
    "runtime",
    "action",
    "sensitive_regions",
    "observation_path",
    "credential_path"
  ],
  "additionalProperties": false
}
