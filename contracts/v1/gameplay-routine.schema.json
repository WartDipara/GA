{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/gameplay-routine",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "screen",
                    "control",
                    "focused_package",
                    "alive"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          },
          "action": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "tap",
                  "swipe",
                  "long_press",
                  "back",
                  "wait",
                  "credential",
                  "launch",
                  "return"
                ]
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "end_x": {
                "type": "integer",
                "minimum": 0
              },
              "end_y": {
                "type": "integer",
                "minimum": 0
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30000
              },
              "bounds": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "credential_field": {
                "enum": [
                  "username",
                  "password",
                  null
                ]
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "end_x",
              "end_y",
              "duration_ms",
              "bounds",
              "credential_field"
            ],
            "additionalProperties": false
          },
          "after": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "screen",
                    "control",
                    "focused_package",
                    "alive"
                  ]
                },
                "value": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "before",
          "action",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    }
  },
  "required": [
    "steps"
  ],
  "additionalProperties": false
}
