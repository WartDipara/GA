{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/gameplay-decision",
  "type": "object",
  "properties": {
    "observation_id": {
      "type": "string",
      "maxLength": 2000
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "minItems": 1
    },
    "objective": {
      "type": "string",
      "maxLength": 2000
    },
    "reason_summary": {
      "type": "string",
      "maxLength": 2000
    },
    "expected_outcome": {
      "type": "string",
      "maxLength": 2000
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "disposition": {
      "enum": [
        "action",
        "wait",
        "complete",
        "blocked"
      ]
    },
    "risk": {
      "enum": [
        "none",
        "game_resource",
        "real_payment",
        "account_delete",
        "unknown"
      ]
    },
    "action": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "tap",
                "swipe",
                "long_press",
                "back",
                "wait",
                "credential",
                "launch",
                "return"
              ]
            },
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "end_x": {
              "type": "integer",
              "minimum": 0
            },
            "end_y": {
              "type": "integer",
              "minimum": 0
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            "bounds": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                {
                  "type": "null"
                }
              ]
            },
            "credential_field": {
              "enum": [
                "username",
                "password",
                null
              ]
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "end_x",
            "end_y",
            "duration_ms",
            "bounds",
            "credential_field"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_outcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "deviated",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "required": [
        "status",
        "reason",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "identity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "small_account": {
              "type": [
                "string",
                "null"
              ]
            },
            "server": {
              "type": [
                "string",
                "null"
              ]
            },
            "role": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "small_account",
            "server",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sensitive_regions": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 4,
        "maxItems": 4
      },
      "maxItems": 30
    },
    "local_after": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "screen",
              "image",
              "control",
              "focused_package",
              "alive"
            ]
          },
          "value": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false
      },
      "maxItems": 10
    },
    "subgoals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "maxItems": 20
          },
          "status": {
            "enum": [
              "pending",
              "active",
              "verified",
              "blocked",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "description",
          "requires",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "progress_update": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "discovered",
              "attempted",
              "verified",
              "blocked",
              "unknown"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2000
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "description",
          "status",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "state_key": {
      "type": "string",
      "maxLength": 2000
    },
    "progress_observed": {
      "type": "boolean"
    },
    "recovery": {
      "type": "object",
      "properties": {
        "fault": {
          "enum": [
            "session_expired",
            "game_process_exit",
            "navigation_deviation",
            "stalled_progress",
            "unexpected_modal"
          ]
        },
        "phase": {
          "enum": [
            "begin",
            "continue",
            "resolved"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": [
        "fault",
        "phase",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "battle_progress": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "preparing",
            "active",
            "settlement",
            "cleared",
            "blocked",
            "unknown"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_auto_observed": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 10
        },
        "settlement_result": {
          "enum": [
            "victory",
            "defeat",
            "unknown"
          ]
        }
      },
      "required": [
        "phase",
        "stage",
        "native_auto_observed",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "exploration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "page_key": {
              "type": "string",
              "maxLength": 240
            },
            "label": {
              "type": "string",
              "maxLength": 240
            },
            "variant": {
              "type": "string",
              "maxLength": 240
            },
            "layout": {
              "type": "string",
              "maxLength": 240
            },
            "kind": {
              "enum": [
                "screen",
                "modal",
                "external"
              ]
            },
            "authenticated": {
              "type": "boolean"
            },
            "inventory_complete": {
              "type": "boolean"
            },
            "is_root": {
              "type": "boolean"
            },
            "anchors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "bounds": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "resource_id": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "required": [
                  "key",
                  "bounds",
                  "resource_id"
                ],
                "additionalProperties": false
              },
              "maxItems": 12
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "container": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "item": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "kind": {
                    "enum": [
                      "tap",
                      "scroll"
                    ]
                  },
                  "intent": {
                    "enum": [
                      "navigate",
                      "tab",
                      "close",
                      "resource",
                      "input",
                      "scroll"
                    ]
                  },
                  "bounds": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  "risk": {
                    "enum": [
                      "none",
                      "game_resource",
                      "real_payment",
                      "account_delete",
                      "unknown"
                    ]
                  },
                  "availability": {
                    "enum": [
                      "enabled",
                      "locked",
                      "disabled"
                    ]
                  },
                  "condition": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "required": [
                  "key",
                  "label",
                  "container",
                  "item",
                  "kind",
                  "intent",
                  "bounds",
                  "risk",
                  "availability",
                  "condition"
                ],
                "additionalProperties": false
              },
              "maxItems": 500
            },
            "scroll_review": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "at_end": {
                    "type": "boolean"
                  },
                  "unbounded": {
                    "type": "boolean"
                  },
                  "loading": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "required": [
                  "key",
                  "at_end",
                  "unbounded",
                  "loading",
                  "reason"
                ],
                "additionalProperties": false
              },
              "maxItems": 20
            }
          },
          "required": [
            "page_key",
            "label",
            "variant",
            "layout",
            "kind",
            "authenticated",
            "inventory_complete",
            "is_root",
            "anchors",
            "elements",
            "scroll_review"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "observation_id",
    "evidence_refs",
    "objective",
    "reason_summary",
    "expected_outcome",
    "uncertainties",
    "disposition",
    "risk",
    "action",
    "previous_outcome",
    "identity",
    "sensitive_regions",
    "local_after"
  ],
  "additionalProperties": false
}
