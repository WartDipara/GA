{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/otlp-trace-export",
  "type": "object",
  "properties": {
    "resourceSpans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "object",
            "properties": { "attributes": { "$ref": "#/$defs/attributes" } },
            "required": ["attributes"],
            "additionalProperties": false
          },
          "scopeSpans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "object",
                  "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
                  "required": ["name", "version"],
                  "additionalProperties": false
                },
                "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } }
              },
              "required": ["scope", "spans"],
              "additionalProperties": false
            }
          }
        },
        "required": ["resource", "scopeSpans"],
        "additionalProperties": false
      }
    }
  },
  "required": ["resourceSpans"],
  "additionalProperties": false,
  "$defs": {
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "value": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "stringValue": { "type": "string", "maxLength": 256 },
              "intValue": { "type": "string", "pattern": "^-?[0-9]+$" },
              "doubleValue": { "type": "number" },
              "boolValue": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "required": ["key", "value"],
        "additionalProperties": false
      }
    },
    "span": {
      "type": "object",
      "properties": {
        "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "parentSpanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": [1, 3] },
        "startTimeUnixNano": { "type": "string", "pattern": "^[0-9]+$" },
        "endTimeUnixNano": { "type": "string", "pattern": "^[0-9]+$" },
        "attributes": { "$ref": "#/$defs/attributes" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "traceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
              "spanId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
            },
            "required": ["traceId", "spanId"],
            "additionalProperties": false
          }
        },
        "status": {
          "type": "object",
          "properties": { "code": { "enum": [0, 1, 2] } },
          "required": ["code"],
          "additionalProperties": false
        }
      },
      "required": [
        "traceId",
        "spanId",
        "name",
        "kind",
        "startTimeUnixNano",
        "endTimeUnixNano",
        "attributes",
        "links",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
