{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/task-session",
  "type": "object",
  "properties": {
    "session_id": { "type": "string" },
    "scope": { "const": "business_task" },
    "executions": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "next_before": { "type": ["integer", "null"], "minimum": 0 },
    "before": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "source_event_seq": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "session_id",
    "scope",
    "executions",
    "next_before",
    "before",
    "limit",
    "source_event_seq"
  ],
  "additionalProperties": false
}
