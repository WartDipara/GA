{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/execution-request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "create"
        },
        "task_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "spec": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "operation",
        "task_id",
        "mode"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "run"
        },
        "run_id": {
          "type": "string"
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation",
        "run_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "recover"
        }
      },
      "required": [
        "operation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "report"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pending": {
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "pending"
      ],
      "additionalProperties": false
    }
  ]
}
