{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/intake-request",
  "type": "object",
  "properties": {
    "task": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "enum": [
                "android",
                "fixture"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_actions": {
                  "type": "integer",
                  "minimum": 0
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "max_actions",
                "timeout_seconds"
              ],
              "additionalProperties": false
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "objective",
            "platform",
            "target",
            "scope",
            "limits",
            "constraints"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object"
    },
    "ai": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "task",
    "sources",
    "defaults",
    "ai"
  ],
  "additionalProperties": false
}
