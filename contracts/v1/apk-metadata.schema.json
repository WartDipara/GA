{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/apk-metadata",
  "type": "object",
  "properties": {
    "apkName": { "type": "string", "minLength": 1 },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "versionName": { "type": ["string", "null"] },
    "versionCode": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "required": ["apkName", "packageName", "versionName", "versionCode", "sizeBytes", "sha256"],
  "additionalProperties": false
}
