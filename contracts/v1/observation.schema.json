{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/observation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "orientation": {
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "session_id",
    "captured_at",
    "width",
    "height",
    "orientation",
    "evidence_refs",
    "fixture"
  ],
  "additionalProperties": false
}
