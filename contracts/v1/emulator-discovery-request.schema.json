{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/emulator-discovery-request",
  "type": "object",
  "properties": {
    "manager_executable": { "type": ["string", "null"], "minLength": 1 },
    "adb_executable": { "type": ["string", "null"], "minLength": 1 },
    "instance_index": { "type": ["integer", "null"], "minimum": 0 },
    "capture": { "type": "boolean" },
    "workspace": { "type": "string", "minLength": 1 },
    "command_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 }
  },
  "required": [
    "manager_executable",
    "adb_executable",
    "instance_index",
    "capture",
    "workspace",
    "command_timeout_seconds"
  ],
  "additionalProperties": false
}
