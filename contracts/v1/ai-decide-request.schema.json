{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/ai-decide-request",
  "type": "object",
  "properties": {
    "codex": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "enum": ["low", "medium", "high", "xhigh", "max"]
        }
      },
      "required": [
        "executable",
        "version",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "turn": {
      "type": "object",
      "properties": {
        "input": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "skill"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "name",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "localImage"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "required": [
        "input",
        "outputSchema"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "codex",
    "workspace",
    "role",
    "thread_id",
    "turn"
  ],
  "additionalProperties": false
}
