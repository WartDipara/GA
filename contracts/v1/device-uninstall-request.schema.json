{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/device-uninstall-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "manager_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adb_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "instance_index": {
          "type": "integer",
          "minimum": 0
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "command_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "manager_executable",
        "adb_executable",
        "instance_index",
        "instance_id",
        "serial",
        "command_timeout_seconds"
      ],
      "additionalProperties": false
    },
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "installed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "session",
    "package_name",
    "installed_sha256"
  ]
}
