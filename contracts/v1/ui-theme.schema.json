{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/ui-theme",
  "type": "object",
  "properties": {
    "default_mode": {
      "enum": [
        "dark",
        "light"
      ]
    },
    "tokens": {
      "type": "object",
      "required": [
        "font-mono",
        "radius-sm",
        "radius-md",
        "radius-lg",
        "space-1",
        "space-2",
        "space-3",
        "space-4",
        "space-5",
        "space-6",
        "duration-fast",
        "duration-normal",
        "duration-enter",
        "motion-distance"
      ],
      "anyOf": [
        {
          "required": [
            "font-body"
          ]
        },
        {
          "required": [
            "font-sans"
          ]
        }
      ],
      "$ref": "#/$defs/styleTokens"
    },
    "themes": {
      "type": "object",
      "properties": {
        "dark": {
          "$ref": "#/$defs/palette"
        },
        "light": {
          "$ref": "#/$defs/palette"
        }
      },
      "required": [
        "dark",
        "light"
      ],
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "font_size": {
          "type": "integer",
          "minimum": 14,
          "maximum": 22
        },
        "min_font_size": {
          "type": "integer",
          "minimum": 12,
          "maximum": 16
        },
        "max_font_size": {
          "type": "integer",
          "minimum": 18,
          "maximum": 28
        },
        "design_font_size": {
          "type": "integer",
          "minimum": 12,
          "maximum": 20
        },
        "minimum_text_ratio": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1
        },
        "reduce_motion": {
          "type": "boolean"
        }
      },
      "required": [
        "font_size",
        "min_font_size",
        "max_font_size",
        "design_font_size",
        "minimum_text_ratio",
        "reduce_motion"
      ],
      "additionalProperties": false
    },
    "default_style": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "styles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/style"
      }
    }
  },
  "required": [
    "default_mode",
    "tokens",
    "themes"
  ],
  "additionalProperties": false,
  "$defs": {
    "palette": {
      "type": "object",
      "properties": {
        "bg": {
          "type": "string"
        },
        "surface": {
          "type": "string"
        },
        "surface-raised": {
          "type": "string"
        },
        "surface-hover": {
          "type": "string"
        },
        "border": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "muted": {
          "type": "string"
        },
        "accent": {
          "type": "string"
        },
        "accent-soft": {
          "type": "string"
        },
        "positive": {
          "type": "string"
        },
        "warning": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "shadow": {
          "type": "string"
        },
        "overlay-contrast": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bg",
        "surface",
        "surface-raised",
        "surface-hover",
        "border",
        "text",
        "muted",
        "accent",
        "accent-soft",
        "positive",
        "warning",
        "negative",
        "info",
        "shadow",
        "overlay-contrast"
      ],
      "additionalProperties": false
    },
    "styleTokens": {
      "type": "object",
      "properties": {
        "font-sans": {
          "type": "string"
        },
        "font-mono": {
          "type": "string"
        },
        "radius-sm": {
          "type": "string"
        },
        "radius-md": {
          "type": "string"
        },
        "radius-lg": {
          "type": "string"
        },
        "space-1": {
          "type": "string"
        },
        "space-2": {
          "type": "string"
        },
        "space-3": {
          "type": "string"
        },
        "space-4": {
          "type": "string"
        },
        "space-5": {
          "type": "string"
        },
        "space-6": {
          "type": "string"
        },
        "duration-fast": {
          "type": "string"
        },
        "duration-normal": {
          "type": "string"
        },
        "duration-enter": {
          "type": "string"
        },
        "motion-distance": {
          "type": "string"
        },
        "font-body": {
          "type": "string",
          "minLength": 1
        },
        "font-display": {
          "type": "string",
          "minLength": 1
        },
        "sidebar-width": {
          "type": "string",
          "minLength": 1
        },
        "duration-navigation": {
          "type": "string",
          "minLength": 1
        },
        "content-width": {
          "type": "string",
          "minLength": 1
        },
        "panel-padding": {
          "type": "string",
          "minLength": 1
        },
        "panel-gap": {
          "type": "string",
          "minLength": 1
        },
        "panel-border-width": {
          "type": "string",
          "minLength": 1
        },
        "heading-size": {
          "type": "string",
          "minLength": 1
        },
        "heading-weight": {
          "type": "string",
          "minLength": 1
        },
        "heading-tracking": {
          "type": "string",
          "minLength": 1
        },
        "heading-color": {
          "type": "string",
          "minLength": 1
        },
        "card-background-image": {
          "type": "string",
          "minLength": 1
        },
        "card-decoration": {
          "type": "string",
          "minLength": 1
        },
        "logo-radius": {
          "type": "string",
          "minLength": 1
        },
        "logo-background": {
          "type": "string",
          "minLength": 1
        },
        "control-border-width": {
          "type": "string",
          "minLength": 1
        },
        "control-shadow": {
          "type": "string",
          "minLength": 1
        },
        "control-hover-shadow": {
          "type": "string",
          "minLength": 1
        },
        "control-active-shadow": {
          "type": "string",
          "minLength": 1
        },
        "control-active-transform": {
          "type": "string",
          "minLength": 1
        },
        "nav-active-shadow": {
          "type": "string",
          "minLength": 1
        },
        "nav-marker": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "reference": {
          "type": "string",
          "pattern": "^https://www\\.stylekit\\.top/(zh/)?styles/[a-z0-9-]+$"
        },
        "default_mode": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "layout": {
          "enum": [
            "balanced",
            "reading",
            "bento"
          ]
        },
        "tokens": {
          "$ref": "#/$defs/styleTokens"
        },
        "themes": {
          "$ref": "#/properties/themes"
        }
      },
      "required": [
        "name",
        "description",
        "reference",
        "default_mode",
        "layout"
      ],
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "default_style": [
      "styles"
    ],
    "styles": [
      "default_style"
    ]
  }
}
