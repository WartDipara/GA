{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/emulator-discovery-result",
  "type": "object",
  "properties": {
    "provider": { "const": "mumu" },
    "status": { "enum": ["ready", "blocked"] },
    "instances": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "status": { "enum": ["stopped", "starting", "ready", "blocked"] },
          "serial": { "type": ["string", "null"], "minLength": 1 },
          "android_version": { "type": ["string", "null"], "minLength": 1 },
          "abis": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
          "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
          "shell_uid": { "type": ["integer", "null"], "minimum": 0 },
          "screenshot": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "file_name": { "type": "string", "pattern": "^instance_[0-9]+\\.png$" },
                  "size_bytes": { "type": "integer", "minimum": 24, "maximum": 16777216 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
                  "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
                },
                "required": ["file_name", "size_bytes", "sha256", "width", "height"],
                "additionalProperties": false
              }
            ]
          },
          "error": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "message": { "type": "string" },
                  "retryable": { "type": "boolean" }
                },
                "required": ["code", "message", "retryable"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "index",
          "name",
          "status",
          "serial",
          "android_version",
          "abis",
          "width",
          "height",
          "shell_uid",
          "screenshot",
          "error"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "ready" } } },
            "then": {
              "properties": {
                "serial": { "type": "string" },
                "android_version": { "type": "string" },
                "abis": { "minItems": 1 },
                "width": { "type": "integer" },
                "height": { "type": "integer" },
                "shell_uid": { "type": "integer" },
                "error": { "type": "null" }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["provider", "status", "instances"],
  "additionalProperties": false
}
