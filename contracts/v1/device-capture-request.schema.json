{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/device-capture-request",
  "type": "object",
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "manager_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "adb_executable": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "instance_index": {
          "type": "integer",
          "minimum": 0
        },
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "command_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "manager_executable",
        "adb_executable",
        "instance_index",
        "instance_id",
        "serial",
        "command_timeout_seconds"
      ],
      "additionalProperties": false
    },
    "package_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "workspace": {
      "type": "string",
      "maxLength": 2000
    },
    "sensitive_regions": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 4,
        "maxItems": 4
      },
      "maxItems": 30
    },
    "credential_path": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "session",
    "package_name",
    "workspace",
    "sensitive_regions",
    "credential_path"
  ],
  "additionalProperties": false
}
