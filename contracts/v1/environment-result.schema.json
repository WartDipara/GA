{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-automation.local/contracts/v1/environment-result",
  "type": "object",
  "properties": {
    "status": { "enum": ["ready", "blocked"] },
    "device_serial": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "package_paths": {
      "type": "array",
      "items": { "type": "string", "pattern": "^/" }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "blocked"] },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "command_id": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          }
        },
        "required": ["name", "status", "code", "message", "command_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["status", "device_serial", "package_paths", "checks"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ready" } } },
      "then": {
        "properties": {
          "device_serial": { "type": "string" },
          "package_paths": { "minItems": 1 },
          "checks": { "items": { "properties": { "status": { "const": "passed" } } } }
        }
      },
      "else": {
        "properties": {
          "checks": { "contains": { "properties": { "status": { "const": "blocked" } } } }
        }
      }
    }
  ]
}
