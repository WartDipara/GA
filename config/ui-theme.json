{
  "default_mode": "dark",
  "tokens": {
    "font-sans": "Inter, 'Segoe UI', system-ui, sans-serif",
    "font-mono": "'Cascadia Code', 'SFMono-Regular', Consolas, monospace",
    "radius-sm": "6px",
    "radius-md": "10px",
    "radius-lg": "16px",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "duration-fast": "140ms",
    "duration-normal": "220ms",
    "duration-enter": "320ms",
