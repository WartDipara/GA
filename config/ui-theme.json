    "light": {
      "bg": "#f5f7fb",
      "surface": "#ffffff",
      "surface-raised": "#f0f3f9",
      "surface-hover": "#e8edf6",
      "border": "#dce3ee",
      "text": "#202b3d",
      "muted": "#606f86",
      "accent": "#6156cc",
      "accent-soft": "#eeebff",
      "positive": "#16795b",
      "warning": "#946111",
      "negative": "#bb3e59",
      "info": "#276c96",
      "shadow": "0 12px 36px #263c6610",
      "overlay-contrast": "#ffffff"
    }
  }
}
